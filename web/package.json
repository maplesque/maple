{
  "name": "maple-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build --target web --out-dir web/src/wasm --out-name maple --manifest-path ../Cargo.toml"
  },
  "dependencies": {
    "@unocss/reset": "^66.6.0",
    "unocss": "^66.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.1.156",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/language-core": "^3.2.2",
    "playwright": "^1.57.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^3.2.2"
  }
}
